# Required authentication
OPENAI_API_KEY=

# DFFP extraction model (OpenAI Responses API + Structured Outputs)
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=30000
OPENAI_TIMEOUT_SECONDS=240
OPENAI_MAX_RETRIES=2

# Release-locked prompts / schema. Old version pins are ignored unless the explicit override flag is enabled.
DFFP_ALLOW_RELEASE_CONFIG_OVERRIDE=false
DFFP_SYSTEM_PROMPT_VERSION=system_v2
DFFP_EXTRACTION_PROMPT_VERSION=extraction_v12
DFFP_SCHEMA_VERSION=fairagro-dffp-v3.5.2
# Keep test for trial outputs. Set publication only for runs intended for the publication gate.
DFFP_RUN_PURPOSE=test

# Docling source-package ingestion
DFFP_SOURCE_PACKAGE_ROOT=scientific_source_packages
DFFP_TABLE_MODE=accurate
DFFP_FORMULA_ENRICHMENT=true
DFFP_OCR_MODE=auto
DFFP_RECOVERY_RENDER_DPI=300

# Structured visual recovery
DFFP_RUN_RECOVERY=true
FAIRAGRO_VISION_API_URL=https://api.openai.com/v1/responses
FAIRAGRO_VISION_API_TYPE=responses
FAIRAGRO_VISION_MODEL=gpt-5.6-luna
FAIRAGRO_VISION_REASONING_EFFORT=medium
FAIRAGRO_VISION_MAX_TOKENS=12000
DFFP_RECOVERY_PRIORITIES=high,medium
DFFP_RECOVERY_STATUSES=required,recommended,review

# Source-bundle controls
DFFP_INCLUDE_ALL_TABLES=true
DFFP_INCLUDE_RECOVERED_FIGURES=true
DFFP_INCLUDE_FORMULAS=true
DFFP_MAX_STRUCTURED_ITEM_CHARS=30000

# Optional focused semantic repair (errors plus selected qualitative-coverage warnings)
DFFP_SEMANTIC_REPAIR=true
DFFP_SEMANTIC_REPAIR_MAX_ATTEMPTS=1
DFFP_SEMANTIC_REPAIR_PROMPT_VERSION=repair_v4
